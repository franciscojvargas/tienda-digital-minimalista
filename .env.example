# ══════════════════════════════════════════════════════════════════════
#  Copia este archivo como .env y rellena las 3 claves obligatorias.
#  El proyecto valida las variables al arrancar: si falta una,
#  el error te dirá exactamente cuál.
# ══════════════════════════════════════════════════════════════════════

# ── Stripe (OBLIGATORIAS) ─────────────────────────────────────────────
# Clave secreta: Dashboard → Developers → API keys.
# Usa sk_test_... para probar y sk_live_... en producción.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de firma del webhook: Dashboard → Developers → Webhooks → tu endpoint.
# En local lo imprime: stripe listen --forward-to localhost:4321/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend / emails (OBLIGATORIA) ─────────────────────────────────────
# API key: resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Opcionales (tienen valores por defecto sensatos) ──────────────────
# Email que RECIBE las alertas de venta.
# Por defecto: el emailSoporte definido en src/config.mjs
# ADMIN_EMAIL=tu-email@ejemplo.com

# Remitente de los emails. Debe ser un dominio verificado en Resend.
# Por defecto: "onboarding@resend.dev" (solo entrega a tu propio email;
# suficiente para probar, verifica tu dominio antes de vender de verdad).
# FROM_EMAIL="Mi Tienda <pedidos@mitienda.com>"
