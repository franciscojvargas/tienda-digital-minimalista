---
import '../styles/global.css';
import { TIENDA } from '../config.mjs';
import { productos } from '../lib/productos.js';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = TIENDA.descripcion, noindex = false } = Astro.props;

// Producto destacado: el primero del catálogo (el CTA de la cabecera).
const destacado = productos[0];

// URL canónica absoluta de la página actual (site en astro.config.mjs).
const urlCanonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenOg = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#9a3a22" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={TIENDA.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: TIENDA.nombre,
      url: Astro.site?.href,
      description: TIENDA.descripcion,
      inLanguage: 'es',
      publisher: {
        '@type': 'Organization',
        name: TIENDA.nombre,
        url: Astro.site?.href,
        logo: new URL('/apple-touch-icon.png', Astro.site).href,
        email: TIENDA.emailSoporte,
      },
    })} />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased flex flex-col">
    <header class="sticky top-0 z-40 border-b border-stone-200 bg-stone-50/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="font-display text-lg font-semibold tracking-tight">
          {TIENDA.nombre}
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a href="/#pack" class="hidden sm:inline font-medium text-stone-600 transition hover:text-almagre-700">
            El producto
          </a>
          <a href="/#faq" class="font-medium text-stone-600 transition hover:text-almagre-700">
            Preguntas
          </a>
          <a
            href="/#pack"
            class="hidden rounded-lg bg-stone-900 px-4 py-2 font-medium text-white transition hover:bg-almagre-700 sm:inline-block"
          >
            Comprar · {destacado.precio} {TIENDA.simboloMoneda}
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200 bg-white">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <div class="flex flex-col justify-between gap-8 sm:flex-row">
          <div class="max-w-xs">
            <p class="font-display text-base font-semibold">{TIENDA.nombre}</p>
            <p class="mt-2 text-xs leading-relaxed text-stone-500">
              {TIENDA.descripcion}
            </p>
          </div>
          <div class="flex gap-12 text-xs">
            <div>
              <p class="mb-2 font-semibold uppercase tracking-wider text-stone-400">Tienda</p>
              <ul class="space-y-1.5 text-stone-600">
                <li><a href="/#pack" class="hover:text-almagre-700">El producto</a></li>
                <li><a href="/#faq" class="hover:text-almagre-700">Preguntas frecuentes</a></li>
              </ul>
            </div>
            <div>
              <p class="mb-2 font-semibold uppercase tracking-wider text-stone-400">Legal</p>
              <ul class="space-y-1.5 text-stone-600">
                <li><a href="/aviso-legal" class="hover:text-almagre-700">Aviso legal</a></li>
                <li><a href="/privacidad" class="hover:text-almagre-700">Privacidad</a></li>
                <li><a href="/terminos" class="hover:text-almagre-700">Términos de venta</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8 border-t border-stone-100 pt-5 text-center text-xs text-stone-400 sm:text-left">
          © {new Date().getFullYear()} {TIENDA.nombre} · Pago seguro con Stripe ·
          Soporte: <a href={`mailto:${TIENDA.emailSoporte}`} class="underline underline-offset-2 hover:text-stone-600">{TIENDA.emailSoporte}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
