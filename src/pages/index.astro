---
import Layout from '../layouts/Layout.astro';
import { productos } from '../lib/productos.js';
import { TIENDA } from '../config.mjs';
---

<Layout title={`${TIENDA.nombre} — ${TIENDA.titular}`}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-10 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-balance">
      {TIENDA.titular}
    </h1>
    <p class="mt-4 text-lg text-stone-500 max-w-xl mx-auto">
      {TIENDA.subtitular}
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {productos.map((producto) => (
        <article class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-7 shadow-sm transition hover:shadow-md hover:border-emerald-200">
          <h2 class="text-lg font-semibold tracking-tight">{producto.nombre}</h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-500 flex-1">{producto.descripcion}</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-3xl font-bold">{producto.precio}{TIENDA.simboloMoneda}</span>
            <span class="text-xs text-stone-400">pago único</span>
          </div>
          <button
            type="button"
            class="btn-comprar mt-5 w-full rounded-xl bg-stone-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-emerald-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-wait"
            data-producto-id={producto.id}
          >
            Comprar ahora
          </button>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-xs text-stone-400">
      Serás redirigido a Stripe para completar el pago de forma segura. No almacenamos datos de tu tarjeta.
    </p>
  </section>
</Layout>

<script>
  // Al pulsar "Comprar ahora" pedimos al endpoint serverless una sesión de
  // Stripe Checkout y redirigimos. Ningún dato sensible pasa por este sitio.
  document.querySelectorAll<HTMLButtonElement>('.btn-comprar').forEach((boton) => {
    boton.addEventListener('click', async () => {
      boton.disabled = true;
      const textoOriginal = boton.textContent;
      boton.textContent = 'Redirigiendo…';

      try {
        const respuesta = await fetch('/api/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productoId: boton.dataset.productoId }),
          // Si la red o el servidor se cuelgan, el botón se recupera solo.
          signal: AbortSignal.timeout(15_000),
        });

        if (!respuesta.ok) throw new Error('No se pudo iniciar el pago');

        const { url } = await respuesta.json();
        window.location.href = url;
      } catch {
        boton.disabled = false;
        boton.textContent = textoOriginal;
        alert('Ha ocurrido un error al iniciar el pago. Inténtalo de nuevo.');
      }
    });
  });
</script>
